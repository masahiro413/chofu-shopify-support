<div class="clp">
<section class="bg-[#f5f5f7] px-5 py-24 text-[#1d1d1f] sm:py-32">
  <div class="mx-auto max-w-2xl">
    <h2 class="text-center text-3xl font-semibold sm:text-5xl">{{ section.settings.name }}</h2>
    <p class="mt-3 text-center text-[#6e6e73]">{{ section.settings.meta }}</p>
    <div class="mt-12 space-y-5 text-[#6e6e73]">{{ section.settings.body }}</div>
    {%- if section.settings.link_label != blank -%}<p class="mt-8 text-center"><a href="{{ section.settings.link_url }}" target="_blank" rel="noopener" class="text-lg text-[#008060] hover:underline">{{ section.settings.link_label }} ›</a></p>{%- endif -%}
  </div>
</section>
</div>

{% schema %}
{
  "name": "LP：私について",
  "tag": "section",
  "class": "clp-section",
  "settings": [
    {
      "type": "text",
      "id": "name",
      "label": "名前"
    },
    {
      "type": "text",
      "id": "meta",
      "label": "肩書き"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "本文"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "リンクの文字"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "リンク先"
    }
  ],
  "presets": [
    {
      "name": "LP：私について"
    }
  ]
}
{% endschema %}
