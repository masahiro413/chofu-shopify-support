<div class="clp">
<section id="works" class="bg-white px-3 py-24 text-[#1d1d1f] sm:px-5 sm:py-32">
  <h2 class="text-center text-3xl font-semibold sm:text-5xl">{{ section.settings.heading }}</h2>
  <div class="mx-auto mt-14 grid max-w-[1200px] gap-3 md:grid-cols-2">
    {%- for block in section.blocks -%}
    {%- if block.settings.image != blank -%}{%- assign wimg = block.settings.image | image_url: width: 1600 -%}{%- else -%}{%- assign wimg = block.settings.image_src -%}{%- endif -%}
    <article class="flex flex-col overflow-hidden rounded-[28px] px-6 pt-12 text-center sm:px-10{% if block.settings.wide %} md:col-span-2{% endif %}{% if block.settings.dark %} bg-[#0f1a33] text-white{% else %} bg-[#f5f5f7]{% endif %}" {{ block.shopify_attributes }}>
      <p class="text-sm{% if block.settings.dark %} text-[#d4b25a]{% else %} text-[#6e6e73]{% endif %}">{{ block.settings.kind }}</p>
      <h3 class="mt-1 text-4xl font-semibold sm:text-5xl">{{ block.settings.name }}</h3>
      <p class="mx-auto mt-4 max-w-xl{% if block.settings.dark %} text-white/75{% else %} text-[#6e6e73]{% endif %}">{{ block.settings.body }}</p>
      <p class="mx-auto mt-4 max-w-xl text-sm{% if block.settings.dark %} text-white/60{% else %} text-[#86868b]{% endif %}">{{ block.settings.details }}</p>
      <div class="mt-auto pt-10">
        {%- if wimg != blank -%}<img src="{{ wimg }}" alt="{{ block.settings.name | escape }}のトップページ" class="mx-auto w-full rounded-t-2xl object-cover object-top shadow-xl{% if block.settings.wide %} aspect-[16/8] max-w-4xl{% else %} aspect-[16/11]{% endif %}" loading="lazy">
        {%- else -%}<div class="flex aspect-[16/11] w-full flex-col items-center justify-center rounded-t-2xl border border-[#d4b25a]/40 text-[#d4b25a]"><p class="font-serif text-4xl tracking-wide">{{ block.settings.name | split: ' ' | first }}</p></div>{%- endif -%}
      </div>
    </article>
    {%- endfor -%}
  </div>
</section>
</div>

{% schema %}
{
  "name": "LP：制作例",
  "tag": "section",
  "class": "clp-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し"
    }
  ],
  "blocks": [
    {
      "type": "work",
      "name": "お店",
      "settings": [
        {
          "type": "text",
          "id": "kind",
          "label": "種類"
        },
        {
          "type": "text",
          "id": "name",
          "label": "お店の名前"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "説明"
        },
        {
          "type": "textarea",
          "id": "details",
          "label": "使った機能など"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "写真"
        },
        {
          "type": "text",
          "id": "image_src",
          "label": "写真のURL（写真を選んでいないとき）"
        },
        {
          "type": "checkbox",
          "id": "wide",
          "label": "横いっぱいに表示",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "dark",
          "label": "濃紺の背景",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP：制作例"
    }
  ]
}
{% endschema %}
