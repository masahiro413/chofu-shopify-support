<div class="clp">
<section class="bg-[#f5f5f7] px-5 py-24 text-[#1d1d1f] sm:py-32">
  <h2 class="text-center text-3xl font-semibold sm:text-5xl">{{ section.settings.heading }}</h2>
  <div class="mx-auto mt-14 grid max-w-[1024px] gap-4 md:grid-cols-2">
    {%- for block in section.blocks -%}<div class="rounded-[28px] bg-white p-8 sm:p-10" {{ block.shopify_attributes }}><h3 class="text-2xl font-semibold">{{ block.settings.title }}</h3><p class="mt-4 text-[#6e6e73]">{{ block.settings.body }}</p></div>{%- endfor -%}
  </div>
</section>
</div>

{% schema %}
{
  "name": "LP：こんなお店に",
  "tag": "section",
  "class": "clp-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "カード",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "タイトル"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "説明"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP：こんなお店に"
    }
  ]
}
{% endschema %}
