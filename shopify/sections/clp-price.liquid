<div class="clp">
<section id="price" class="bg-[#f5f5f7] px-5 py-24 text-[#1d1d1f] sm:py-32">
  <h2 class="text-center text-3xl font-semibold sm:text-5xl">{{ section.settings.heading }}</h2>
  <p class="mx-auto mt-5 max-w-2xl text-center text-lg text-[#6e6e73]">{{ section.settings.lead }}</p>
  <dl class="mx-auto mt-14 max-w-3xl divide-y divide-[#d2d2d7] rounded-[28px] bg-white px-6 sm:px-10">
    {%- for block in section.blocks -%}<div class="flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8" {{ block.shopify_attributes }}><dt>{{ block.settings.name }}</dt><dd class="sm:text-right"><span class="text-lg font-semibold whitespace-nowrap">{{ block.settings.price }}</span>{%- if block.settings.regular != blank -%}<span class="block text-sm text-[#86868b]">{{ block.settings.regular }}</span>{%- endif -%}</dd></div>{%- endfor -%}
  </dl>
</section>
</div>

{% schema %}
{
  "name": "LP：料金",
  "tag": "section",
  "class": "clp-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "説明文"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "料金の行",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "内容"
        },
        {
          "type": "text",
          "id": "price",
          "label": "金額"
        },
        {
          "type": "text",
          "id": "regular",
          "label": "通常価格（任意）"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP：料金"
    }
  ]
}
{% endschema %}
