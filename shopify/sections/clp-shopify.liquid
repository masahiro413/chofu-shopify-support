<div class="clp">
{%- if section.settings.image != blank -%}{%- assign img = section.settings.image | image_url: width: 2000 -%}{%- else -%}{%- assign img = section.settings.image_src -%}{%- endif -%}
<section id="shopify" class="relative isolate overflow-hidden bg-[#151a1b] pb-24 text-white">
  {%- if img != blank -%}<img src="{{ img }}" alt="{{ section.settings.image_alt | escape }}" class="mb-14 block h-auto w-full brightness-110 contrast-110" loading="lazy">{%- endif -%}
  <div class="mx-auto grid max-w-[1100px] gap-14 px-5 lg:grid-cols-2 lg:gap-20">
    <div>
      <h2 class="text-4xl font-semibold sm:text-6xl">{{ section.settings.heading | newline_to_br }}</h2>
      <span aria-hidden="true" class="mt-8 block h-1 w-40 rounded-full bg-[#5ce65c]"></span>
      <div class="mt-8 space-y-4 text-lg text-white/80">{{ section.settings.body }}</div>
      <p class="mt-4 text-sm text-white/70">{{ section.settings.note }}</p>
    </div>
    <ul class="grid gap-3 sm:grid-cols-2">
      {%- for block in section.blocks -%}
      <li class="rounded-[20px] bg-white/5 p-7 ring-1 ring-white/10{% if forloop.last and forloop.length == 5 %} sm:col-span-2{% endif %}" {{ block.shopify_attributes }}><h3 class="text-lg font-semibold text-[#5ce65c]">{{ block.settings.title }}</h3><p class="mt-3 text-white/80">{{ block.settings.body }}</p></li>
      {%- endfor -%}
    </ul>
  </div>
</section>
</div>

{% schema %}
{
  "name": "LP：Shopifyとは",
  "tag": "section",
  "class": "clp-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "写真"
    },
    {
      "type": "text",
      "id": "image_src",
      "label": "写真のURL（写真を選んでいないときに使用）"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "写真の説明"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "見出し"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "本文"
    },
    {
      "type": "text",
      "id": "note",
      "label": "注記"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "特長",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "タイトル"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "説明"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP：Shopifyとは"
    }
  ]
}
{% endschema %}
