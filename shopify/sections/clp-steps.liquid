<div class="clp">
<section class="bg-white px-5 py-24 text-[#1d1d1f] sm:py-32">
  <h2 class="text-center text-3xl font-semibold sm:text-5xl">{{ section.settings.heading }}</h2>
  <ol class="mx-auto mt-16 grid max-w-[1024px] gap-12 text-center sm:grid-cols-2 lg:grid-cols-4">
    {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><p class="text-5xl font-semibold text-[#008060]">{{ forloop.index }}</p><h3 class="mt-3 text-xl font-semibold">{{ block.settings.title }}</h3><p class="mt-2 text-[#6e6e73]">{{ block.settings.body }}</p></li>{%- endfor -%}
  </ol>
</section>
</div>

{% schema %}
{
  "name": "LP：流れ",
  "tag": "section",
  "class": "clp-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "ステップ",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "タイトル"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "説明"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP：流れ"
    }
  ]
}
{% endschema %}
